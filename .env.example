# Database
DB_USER=jhosua
DB_PASSWORD=change_me
DB_NAME=jhosua
DATABASE_URL=postgres://jhosua:change_me@localhost:5433/jhosua

# Auth
JWT_SECRET=generate_a_long_random_string
ADMIN_EMAIL=admin@jhhogar.com
ADMIN_PASSWORD=JhHogarAdmin2026!

# API / Web
API_PORT=3100
NEXT_PUBLIC_API_URL=http://localhost:3100/api
PUBLIC_WEB_URL=http://localhost:3101

# Production (Swarm) — API bajo el mismo dominio
# NEXT_PUBLIC_API_URL=https://jhosuacomercial.com/api
# PUBLIC_WEB_URL=https://jhosuacomercial.com

# Odoo (multi-empresa) — live: ODOO_MOCK=false + ODOO_API_KEY
# Admin: /admin/odoo → Sincronizar (trae productos + image_128)
ODOO_URL=https://odoo.jhosuacom.example
ODOO_DB=jhosuacom
ODOO_USERNAME=api@jhosuacom.com
ODOO_API_KEY=
ODOO_COMPANY_IDS=
ODOO_PRICELIST_MAYOR=
ODOO_PRICELIST_DETAL=
ODOO_MOCK=true

# WhatsApp — Evolution (evoapi.renace.tech). No pegar key aquí.
# Automático: ./scripts/push-evo.sh toma la clave de rnv-manger/ZAV y la sube al VPS.
# Admin solo genera QR: /admin/whatsapp
EVOLUTION_API_URL=https://evoapi.renace.tech
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=jhhogar
ADMIN_NOTIFY_PHONES=
# Webhook Evolution → Nest (opcional). URL: https://jhosuacomercial.com/api/webhooks/evolution?secret=...
EVOLUTION_WEBHOOK_SECRET=

# Gemini AI (vendedor WA + copiloto admin + chat tienda)
# También configurable en /admin/ia
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Boot (prod Swarm: false; schema/seed vía bootstrap API)
RUN_DB_PUSH=false
RUN_DB_SEED=false
