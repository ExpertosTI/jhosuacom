#!/bin/bash
set -euo pipefail

BRANCH="${1:-feat/jh-hogar-mvp}"

echo "🚀 Pre-push JH Hogar → $BRANCH"

echo "🔨 Build check..."
pnpm --filter @jhosua/db build
pnpm --filter @jhosua/api build
pnpm --filter @jhosua/web build

echo "📤 Git sync..."
git add -A
git status --short

if git diff --cached --quiet; then
  echo "ℹ️  Sin cambios nuevos"
else
  git commit -m "chore: prepush build $(date +'%Y-%m-%d %H:%M:%S')"
fi

git push -u origin "$BRANCH"

echo "✅ Push OK"
echo "En el VPS: cd /opt/jhosuacom && DEPLOY_BRANCH=$BRANCH ./deploy.sh"
