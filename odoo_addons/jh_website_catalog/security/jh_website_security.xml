<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_jh_website" model="ir.module.category">
        <field name="name">JH Hogar Web</field>
        <field name="sequence">56</field>
    </record>

    <record id="group_jh_website_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_jh_website"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_jh_website_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_jh_website"/>
        <field name="implied_ids" eval="[(4, ref('group_jh_website_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Regla multi-compañía -->
    <record id="jh_website_catalog_company_rule" model="ir.rule">
        <field name="name">JH Catalog: multi-company</field>
        <field name="model_id" ref="model_jh_website_catalog"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
